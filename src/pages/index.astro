---
import '../global.css';

import BrandLogos from '../components/BrandLogos.jsx';
import Hero from '../components/Hero.jsx';
import EventSection from '../components/EventSection.jsx';
import ProgramSection from '../components/ProgramSection.jsx';
import PackagesSection from '../components/PackagesSection.jsx';
import MarketsAndSectors from '../components/MarketsAndSectors.jsx';
import StepsSection from '../components/StepsSection.jsx';
import TrackRecord from '../components/TrackRecord.jsx';
import ApplicationForm from '../components/ApplicationForm.jsx';
import FinalCTA from '../components/FinalCTA.jsx';
import Footer from '../components/Footer.jsx';

import { expoData } from '../data/expoData';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{expoData.event.name} {expoData.event.year}</title>
    <link rel="icon" type="image/png" href="/saudievent.png" />
  </head>

  <body id="top">

    <header class="top-nav" id="home">
      <div class="container">
        <BrandLogos client:idle />
      </div>
    </header>

    <div id="hero">
      <Hero client:idle />
    </div>

    <div id="event">
      <EventSection event={expoData.event} client:idle />
    </div>

    <div id="program">
      <ProgramSection program={expoData.program} client:idle />
    </div>

    <div id="packages">
      <PackagesSection packages={expoData.packages} client:idle />
    </div>

    <div id="markets">
      <MarketsAndSectors
        buyerProfiles={expoData.buyerProfiles}
        sectors={expoData.sectors}
        client:idle
      />
    </div>

    <div id="steps">
      <StepsSection steps={expoData.steps} client:idle />
    </div>

    <div id="track-record">
      <TrackRecord trackRecord={expoData.trackRecord} client:idle />
    </div>

    <div id="apply">
      <ApplicationForm packages={expoData.packages} client:load />
    </div>

    <div id="final-cta">
      <FinalCTA event={expoData.event} client:idle />
    </div>

    <footer id="footer">
      <Footer client:idle />
    </footer>

  </body>

  <button id="back-to-top" aria-label="Back to top" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })">
    &#8679;
  </button>
</html>

<style>
  #back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 9999;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: var(--accent);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  #back-to-top.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  #back-to-top:hover {
    filter: brightness(1.15);
    transform: translateY(-2px);
  }
</style>

<script>
  const btn = document.getElementById('back-to-top');
  window.addEventListener('scroll', () => {
    btn.classList.toggle('visible', window.scrollY > 400);
  });
</script>